generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CrmTarget {
  Yes
  No
  Maybe
}

// Read directly from Redash query 10505's crm_status field: A=Active,
// P=Paused, E=Expired. NA means the merchant has never appeared in that
// query (no CRM license history at all).
enum CrmStatus {
  NA
  Active
  Paused
  Expired
}

enum LoyaltyStatus {
  Active
  Inactive
}

enum WabaStatus {
  Active
  Inactive
}

enum OnboardStatus {
  Onboarded
  NotOnboarded
}

enum RistaStatus {
  Active
  Inactive
}

enum DotpeStatus {
  Active
  Inactive
}

// MANAGER: read + CRUD everywhere except Roadmap (read-only there).
// USER: read-only everywhere, no CRUD. MEMBER is retired (see migration) —
// kept out of this list so nothing can write it again, though the
// underlying Postgres enum still carries the value for existing rows.
enum UserRole {
  ADMIN
  MANAGER
  USER
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String
  role              UserRole @default(USER)
  // True for accounts created with a generated temp password — forces a
  // password change on next login before the rest of the app is reachable.
  mustResetPassword Boolean  @default(false)
  // Login lockout: counts consecutive failed attempts since the last
  // success; failedLoginAttempts resets to 0 on a successful login.
  // lockedUntil blocks further attempts (even with the correct password)
  // until that time passes — serverless has no reliable in-memory state
  // across invocations, so this has to be persisted, not counted in memory.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Merchant {
  id String @id @default(cuid())

  // Identity
  ristaBrandId  String? @unique
  dotpeMid      String  @unique
  brandName     String
  pocName       String?
  pocNumber     String?
  // Join keys for the competitor branch-count sheet (Account Number / BusinessID, one row per merchant-provider pair)
  accountNumber String?
  businessId    String?

  // Footprint
  totalStores         Int @default(0)
  activeDineInStores  Int @default(0)
  loyaltyActiveStores Int @default(0)
  // Source: the closures sheet's "Pending outlet closure" column — branches
  // not yet closed. Previously misnamed `paidBranches`, which every reader
  // (including at least one UI label) took to mean the opposite of what it
  // actually held.
  pendingBranches Int @default(0)
  closedBranches  Int @default(0)

  // Commercials
  paymentCollectedDate DateTime?
  closureDate          DateTime?
  paymentCollected     Decimal   @default(0) @db.Decimal(14, 2)
  // computed = activeDineInStores * 10000, kept in sync on write
  totalYearlyPotential Decimal   @default(0) @db.Decimal(14, 2)
  subscriptionRevenue  Decimal   @default(0) @db.Decimal(14, 2)
  creditConsumedL30    Decimal   @default(0) @db.Decimal(14, 2)

  // Competitor presence (branch counts on DotPe CRM's product surface)
  reeloBranches       Int @default(0)
  xenoBranches        Int @default(0)
  dotpeBranches       Int @default(0)
  fudrBranches        Int @default(0)
  easyrewardsBranches Int @default(0)

  // Sales / CRM status
  crmTarget              CrmTarget     @default(Maybe)
  lastDemoStatus         DateTime?
  crmStatus              CrmStatus     @default(NA)
  crmEnabledOn           DateTime?
  // "CRM Activation Status" column, CRM+Loyalty closures tab — the ops-confirmed
  // signal for the dashboard's "Paid" funnel count (crmStatus alone over-counts
  // from Redash's broader crm_merchants table, which includes non-closed rows).
  crmActivationConfirmed Boolean       @default(false)
  loyaltyStatus          LoyaltyStatus @default(Inactive)
  // wabaStatus/ristaStatus/dotpeStatus were previously unpopulated by any
  // sync (always their default) — now fed by the "Has_WABA"/"Has_Rista"/
  // "Has_Dotpe_Orders" flags on Redash query 11166 (syncMxGrain).
  wabaStatus             WabaStatus    @default(Inactive)
  onboarded              OnboardStatus @default(NotOnboarded)
  ristaStatus            RistaStatus   @default(Inactive)
  dotpeStatus            DotpeStatus   @default(Inactive)
  // Also from query 11166 ("Has_CRM"/"Has_Loyalty") — deliberately separate
  // from crmStatus (Redash 10505, the activation-funnel signal) and
  // loyaltyStatus (the dedicated loyalty-funnel query) above, which are
  // both already populated by their own more precise sources; this is the
  // coarser grain-level view specifically for the Licenses section.
  grainHasCrm                    Boolean  @default(false)
  grainHasLoyalty                Boolean  @default(false)
  grainCustomersAcquired         Int      @default(0)
  grainBranchesTransactingPosL90 Int      @default(0)
  grainSyncedAt                  DateTime?

  // Usage
  customerCount            Int     @default(0)
  l30Txn                   Int     @default(0)
  preCrmCredits            Decimal @default(0) @db.Decimal(14, 2)
  postCrmCredits           Decimal @default(0) @db.Decimal(14, 2)
  momCreditConsumption     Decimal @default(0) @db.Decimal(14, 2)
  creditConsumptionBreakup Json?
  totalContactsReached     Int     @default(0)

  // Loyalty
  loyaltyProgram      String?
  loyaltyPointsEarned Int     @default(0)
  loyaltyPointsBurned Int     @default(0)

  // Automations
  automationsRules        Json?
  automationsActivateDate DateTime?
  automationsTotalSent    Int       @default(0)

  // Campaigns
  campaignsSetup           Int @default(0)
  campaignsContactsReached Int @default(0)
  campaignsUsingRfm        Int @default(0)

  // Support
  bugRaised      String?
  featureRequest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots          MerchantSnapshot[]
  supportRequests    SupportRequest[]
  onboardingRequests OnboardingRequest[]

  @@index([brandName])
  @@index([crmStatus])
  @@index([loyaltyStatus])
  @@index([onboarded])
}

model MerchantSnapshot {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fieldName  String
  value      Decimal  @db.Decimal(14, 2)
  capturedAt DateTime @default(now())

  @@unique([merchantId, fieldName, capturedAt])
}

enum SyncSource {
  REDASH
  GSHEETS
}

model SyncRun {
  id         String     @id @default(cuid())
  source     SyncSource
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  success    Boolean    @default(false)
  summary    Json?
  error      String?

  @@index([source, finishedAt])
}

// Portfolio-wide weekly consumed/recharged, pre-synced from Redash so the
// dashboard reads its own DB instead of calling Redash live on every page
// load (that query alone can take 30-60s+ against production data).
model PortfolioTrend {
  id        String   @id @default(cuid())
  week      String   @unique
  consumed  Decimal  @default(0) @db.Decimal(14, 2)
  recharged Decimal  @default(0) @db.Decimal(14, 2)
  syncedAt  DateTime @default(now()) @updatedAt
}

enum SupportRequestType {
  Bug
  Feature
}

model SupportRequest {
  id         String              @id @default(cuid())
  // Nullable: a request can be filed against a merchant that doesn't exist
  // in the Merchant table yet (typed as free text instead) — see
  // merchantNameFreeText. SetNull rather than Cascade so deleting the
  // merchant later doesn't take its request history down with it.
  merchantId String?
  merchant   Merchant?           @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  // Set only when merchantId is null — the name as typed, not backed by a
  // real Merchant row (no totalStores/totalYearlyPotential to auto-fill from).
  merchantNameFreeText String?
  type           SupportRequestType
  description    String
  images         Json? // string[] of file paths under /uploads/requests/{id}/
  // Manual entry at submission time (not auto-computed from merchant data)
  totalBranches  Int                @default(0)
  totalPotential Decimal            @default(0) @db.Decimal(14, 2)
  productRemarks String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdBy      String?

  @@index([merchantId])
  @@index([type])
  @@index([createdAt])
}

model RoadmapItem {
  id               String   @id @default(cuid())
  theme            String?
  title            String
  ticketUrl        String? // raw multi-line "1. url\n2. url" text as stored in the sheet; ticket number (e.g. DM-123) is parsed from this at render time, not stored separately
  design           String? // free text — values are inconsistent in source ("✅" / "Required" / "Not required" / "Not reqd"); manually-created tickets store a design link here instead
  designAttachment String? // uploaded file path, for manually-created tickets whose "Design" is an attachment rather than a link
  rista            String? // "Needed" or blank
  priority         String? // P0/P1/P2/P3/"Picked"/blank
  usp              Boolean  @default(false)
  // Pure dev-lifecycle stage: "To Be Picked" / "In Design" / "In Tech" /
  // "In QA" / "Shipped" — not a strict Prisma enum since the source sheet
  // isn't guaranteed to stay within these 5 values, but every ingest maps
  // into them (see mapRoadmapLifecycleStatus in roadmap-status.ts). Prior
  // to that split, this field also carried category-style values (Feature,
  // Bug, Merchant ask, ...) — those are preserved in `type` below instead.
  status           String
  // The sheet's original status/category label (Feature, Bug, Merchant
  // ask, New Product, Hygiene feature, or blank) — split out of `status`
  // once that became a pure lifecycle field, so this data isn't lost.
  type             String?
  goLiveDate       String? // often not a clean date (e.g. "Sept"), stored as free text
  manpowerWeeks    Decimal? @db.Decimal(6, 2)
  description      String?
  brandSignal      String?
  why              String?
  // Sheet-sourced rows are fully replaced on every sync (the sheet is the
  // source of truth for those); manually-created "product ticket" rows are
  // never touched by the sync so ops-entered tickets survive it.
  isManual         Boolean  @default(false)
  syncedAt         DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([priority])
  @@index([theme])
}

// Mirrors the "Dotpe CRM [Activation] > Loyalty enable" Google Sheet 1:1 —
// column order matches exactly, including the BE's own write-back columns
// (loyaltyEnabled/loyaltyEnabledAt/crmEnabled/crmEnabledAt), which this app
// never writes, only reads back on sync. sheetRowIndex is the join key: it's
// stable across syncs since the sheet is append-only, never reordered.
model OnboardingRequest {
  id            String    @id @default(cuid())
  sheetRowIndex Int       @unique
  timestamp     DateTime?
  email         String?
  businessName  String?

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  enterpriseMerchantId String? // "MerchantID (enterprise):" — matched to Merchant.dotpeMid where possible
  ristaBusinessId      String? // "BusinessID (rista):"
  ristaBrandId         String? // "BrandID (rista):"
  ristaBranchId        String? // "BranchID (rista):"
  branchCode           String?
  storeCode            String?
  enterpriseStoreId    String? // "StoreId (enterprise):"

  loyaltyType         String? // "Visit based loyalty" / "Point based loyalty" (free text — values seen in source)
  automation          Boolean @default(false)
  dotpeUsername       String?
  crmLicenseRequested Boolean @default(false) // "CRM license enable?"

  // BE write-back — this app reads these, never sets them
  loyaltyEnabled   Boolean   @default(false) // "Is Enabled (DO NOT FILL)"
  loyaltyEnabledAt DateTime? // "Enabled At (DO NOT FILL)"
  crmEnabled       Boolean   @default(false) // "CRM is Enabled (DO NOT FILL)"
  crmEnabledAt     DateTime? // "CRM enabled At (DO NOT FILL)"

  additionalComment String?
  remarks           String?

  createdViaPlatform Boolean  @default(false) // true only for requests submitted through this app's native form
  syncedAt           DateTime @default(now()) @updatedAt

  @@index([merchantId])
  @@index([loyaltyEnabled])
  @@index([crmEnabled])
}

enum TemplateChannel {
  SMS
  WhatsApp
}

enum TemplateDealType {
  WithDeal
  WithoutDeal
}

// OTP was merged into Utility (single "Utility" catch-all going forward,
// per an explicit spec update) — existing OTP rows are remapped to Utility
// in the migration, not left dangling under a removed enum value.
enum TemplateCategory {
  Loyalty
  Automation
  Campaign
  Utility
}

// Which WhatsApp Business/Meta account this template is submitted under —
// the same message can be independently submitted per handle, each with its
// own approval lifecycle (see TemplateApproval).
enum TemplateHandle {
  Merchant
  RistaByDotpe
  DotpeCRM
}

// category is nullable because the initial import (from the "automation_templates.csv"
// and "Loyalty and others" sheet tabs) has no reliable category data — ops
// tags these by hand after import. New templates added through the app's
// Add Template form always set one (the dropdown has no blank option).
model Template {
  id          String            @id @default(cuid())
  // Short human name (e.g. "points_earned") — the CSV import's primary key
  // for matching rows on re-upload; older hand-created templates may not
  // have one.
  name        String?
  channel     TemplateChannel
  dealType    TemplateDealType
  messageText String
  category    TemplateCategory?
  handle      TemplateHandle?
  // Free-text MID of the merchant who asked for this template, if any —
  // distinct from TemplateApproval, which tracks the submission/approval
  // lifecycle itself rather than who originally requested it.
  requestedMid String?
  // Which triggering event this template fires for (a business-level event
  // like a points-earned or order-milestone trigger), and whether this is
  // the template that's actually live for that event when more than one
  // template maps to the same eventId. Distinct from TemplateApproval.eventId
  // below, which is a per-submission WhatsApp/Meta review identifier — a
  // template can accumulate several of those across resubmissions, but this
  // eventId is the one stable value driving is_default grouping.
  eventId     String?
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  approvals TemplateApproval[]

  @@index([channel])
  @@index([category])
  @@index([eventId])
}

enum TemplateApprovalStatus {
  Submitted
  Approved
}

// A submission-lifecycle record for the template as a whole (not tied to
// any one merchant) — e.g. "submitted to WhatsApp for review under this
// Handle, got approved, here's the Event ID and Template ID". A template
// can have multiple submission records (resubmissions, or separate
// submissions per Handle).
model TemplateApproval {
  id                 String                 @id @default(cuid())
  templateId         String
  template           Template               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvalStatus     TemplateApprovalStatus @default(Submitted)
  eventId            String?
  providerTemplateId String? // "Template ID" in the UI — assigned once approved, so nullable
  createdAt          DateTime               @default(now())

  @@index([templateId])
}
